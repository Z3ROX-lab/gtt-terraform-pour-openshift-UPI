# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Fichiers Ignition (contiennent des secrets)
*.ign

# Lock files
.terraform.lock.hcl

# Mac OS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Backup files
*.backup
*.bak
